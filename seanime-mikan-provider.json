{
    "id": "seanime-mikan-provider",
    "name": "Mikan Smart Provider",
    "description": "Anime torrent provider extension scraping search and swarm data from mikanani.me",
    "manifestURI": "https://raw.githubusercontent.com/roogue/seanime-mikan-provider/refs/heads/main/seanime-mikan-provider.json",
    "version": "1.0.0",
    "author": "roogue",
    "type": "anime-torrent-provider",
    "language": "typescript",
    "lang": "中文",
    "readme": "",
    "notes": "",
    "userConfig": {
        "requiresConfig": false,
        "version": 1,
        "fields": [
            {
                "name": "preferred_subgroups",
                "label": "Preferred Subtitle Group IDs (Comma Separated)",
                "type": "text",
                "default": ""
            }
        ]
    },
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": [],
            "allow": {
                "networkAccess": {
                    "allowedDomains": [
                        "https://api.bgm.tv/search/subject/*",
                        "https://raw.githubusercontent.com/xiaoyvyv/bangumi-data/main/data/mikan/bangumi-mikan.json",
                        "https://mikanani.me/*"
                    ],
                    "reasoning": "To fetch anime data and torrent information from mikanani.me and related APIs for smart analysis."
                }
            }
        }
    },
    "isDevelopment": false,
    "payloadURI": "https://raw.githubusercontent.com/roogue/seanime-mikan-provider/refs/heads/main/index.ts"
}